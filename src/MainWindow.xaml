<Window x:Class="ServerFavorites.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AppTitle}" Icon="AppIcon.ico" Width="1110" Height="650" MinWidth="760" MinHeight="470" Background="#1B1C22" Foreground="#EDF0F2" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SizeChanged="ResizeDetailsPane">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#B4B3C2"/>
  <SolidColorBrush x:Key="Line" Color="#30313B"/>
  <SolidColorBrush x:Key="Accent" Color="#ACA1CF"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDF0F2"/><Setter Property="Background" Value="#292A34"/><Setter Property="Padding" Value="12,7"/><Setter Property="BorderBrush" Value="#3C3C49"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".80"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#ACA1CF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".42"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#221D32"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="1" CornerRadius="5">
     <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#646173"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="Background" Value="#22232B"/><Setter Property="Foreground" Value="#EDF0F2"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#42424F"/><Setter Property="Padding" Value="9,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="GridViewColumnHeader">
   <Setter Property="Background" Value="#24252E"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="9,0"/><Setter Property="Height" Value="33"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader">
    <Grid>
    <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="7" Cursor="SizeWE">
     <Thumb.Template><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent"><Border Width="1" Margin="0,5,2,5" HorizontalAlignment="Right" Background="#494656"/></Border>
     </ControlTemplate></Thumb.Template>
    </Thumb>
    <Canvas x:Name="PART_FloatingHeaderCanvas" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Role" Value="Padding"><Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="Role" Value="Floating"><Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_FloatingHeaderCanvas" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#30313D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#30313D"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NumberHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
  <Style TargetType="ListViewItem">
   <Setter Property="Foreground" Value="#EDF0F2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="40"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
    <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
     <Grid>
      <GridViewRowPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
      <Border x:Name="Marker" HorizontalAlignment="Left" Width="2" Background="Transparent" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#252630"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#353344"/><Setter TargetName="Marker" Property="Background" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkMenu" TargetType="ContextMenu">
   <Setter Property="Background" Value="#272830"/><Setter Property="Foreground" Value="#EDF0F2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="#494656" BorderThickness="1" CornerRadius="6" Padding="4">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="#EDF0F2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid>
     <Border x:Name="Surface" CornerRadius="4" Background="Transparent" Padding="10,6" MinWidth="148">
      <DockPanel>
       <Path x:Name="Arrow" DockPanel.Dock="Right" Data="M 0,0 L 4,4 L 0,8" Stroke="#B4B3C2" StrokeThickness="1.2" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" Focusable="False"
      IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
      PlacementTarget="{Binding ElementName=Surface}">
      <Border Background="#272830" BorderBrush="#494656" BorderThickness="1" CornerRadius="6" Padding="4">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" MaxHeight="360"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#383647"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkMenuSeparator" TargetType="Separator">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
    <Border Height="1" Background="#3A3845" Margin="6,4"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkScrollBar" TargetType="ScrollBar">

   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border x:Name="TrackSurface" Background="#202128" Padding="1,0">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBack" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="PageForward" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border x:Name="Grip" Background="#545367" CornerRadius="3"/>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#77758A"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#ACA1CF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
     <Setter TargetName="TrackSurface" Property="Padding" Value="0,1"/>
     <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
     <Setter TargetName="PageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
     <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="11"/></Trigger>
    <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="159"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Background="#17181E" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,19">
    <Grid DockPanel.Dock="Bottom" Margin="0,9,0,0">
     <Button x:Name="LanguageButton" HorizontalContentAlignment="Left" Click="ToggleLanguageMenu"
      AutomationProperties.Name="{DynamicResource Language}">
      <TextBlock x:Name="LanguageLabel" Text="繁體中文" TextTrimming="CharacterEllipsis"/>
     </Button>
     <Popup x:Name="LanguagePopup" Placement="Top" PlacementTarget="{Binding ElementName=LanguageButton}"
      VerticalOffset="-4" AllowsTransparency="True" StaysOpen="True" PreviewKeyDown="LanguagePopupKeyDown">
      <Border Background="#272830" BorderBrush="#494656" BorderThickness="1" CornerRadius="6" Padding="4"
       MinWidth="{Binding ActualWidth, ElementName=LanguageButton}">
       <StackPanel x:Name="LanguageOptions" KeyboardNavigation.TabNavigation="Cycle"/>
      </Border>
     </Popup>
    </Grid>
    <Border x:Name="Sidebar" Background="Transparent" AllowDrop="True"
     PreviewDragOver="SidebarDragOver" PreviewDragLeave="SidebarDragLeave" PreviewDrop="SidebarDrop"
     PreviewMouseLeftButtonDown="SidebarMouseDown" PreviewMouseMove="SidebarMouseMove">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Games"/>
     </ScrollViewer>
    </Border>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="17,16,17,13">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,13">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
     <TextBlock x:Name="GroupTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="133"/>
     <TextBlock x:Name="ServerCount" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBox Grid.Column="1" x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="{DynamicResource Search}"/>
    <TextBlock Grid.Column="1" x:Name="Placeholder" Text="{DynamicResource Search}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
     <TextBlock.Style><Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding Text, ElementName=Search}" Value=""/>
       <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Search}" Value="False"/>
      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
    <Button Grid.Column="2" Content="↻" FontSize="16" Padding="9,4" Click="RefreshClick" Margin="6,0,0,0" ToolTip="{DynamicResource RefreshGroup}" AutomationProperties.Name="{DynamicResource RefreshGroup}"/>
    <Button x:Name="AddServerButton" Grid.Column="3" Content="{DynamicResource AddServerAction}" Click="AddServer" Margin="6,0,0,0"/>
   </Grid>
   <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,11,0,0">
    <DockPanel>
     <Button x:Name="JoinButton" DockPanel.Dock="Right" Content="{DynamicResource Join}" Style="{StaticResource Primary}" Click="JoinClick" IsEnabled="False" Margin="10,0,0,0"/>
     <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
   </Border>
   <ListView x:Name="Servers" Background="Transparent" Foreground="#EDF0F2" BorderThickness="0" Padding="0" SelectionMode="Single" SelectionChanged="SelectionChanged" Loaded="InitializeServerScroll" PreviewMouseLeftButtonDown="ServerMouseDown" PreviewMouseMove="ServerMouseMove" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" GridViewColumnHeader.Click="SortClick" ContextMenuOpening="ServerMenuOpening">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
     <EventSetter Event="MouseDoubleClick" Handler="RowDoubleClick"/>
     <EventSetter Event="PreviewMouseRightButtonDown" Handler="SelectRow"/>
    </Style></ListView.ItemContainerStyle>
    <ListView.ContextMenu><ContextMenu Style="{StaticResource DarkMenu}">
     <MenuItem Style="{StaticResource DarkMenuItem}" Tag="ViewDetails" Click="ViewDetails"/><MenuItem Style="{StaticResource DarkMenuItem}" Tag="Join" Click="JoinClick"/>
     <Separator Style="{StaticResource DarkMenuSeparator}"/><MenuItem Style="{StaticResource DarkMenuItem}" Tag="CopyAddress" Click="CopyAddress"/><MenuItem Style="{StaticResource DarkMenuItem}" Tag="CopyLink" Click="CopyLink"/>
     <Separator Style="{StaticResource DarkMenuSeparator}"/><MenuItem Style="{StaticResource DarkMenuItem}" Tag="EditAlias" Click="EditServer"/><MenuItem Style="{StaticResource DarkMenuItem}" x:Name="PinMenu" Header="{DynamicResource Pin}" Click="TogglePin"/>
     <MenuItem Style="{StaticResource DarkMenuItem}" x:Name="MoveMenu" Tag="MoveTo"/><Separator Style="{StaticResource DarkMenuSeparator}"/><MenuItem Style="{StaticResource DarkMenuItem}" Tag="RemoveFavorite" Click="RemoveServer" Foreground="#F4AEA7"/>
    </ContextMenu></ListView.ContextMenu>
    <ListView.View><GridView AllowsColumnReorder="True">
     <GridViewColumn Width="410">
      <GridViewColumn.Header><GridViewColumnHeader x:Name="NameHeader" Content="{DynamicResource Name}" Tag="Name" Padding="32,0,0,0"/></GridViewColumn.Header>
      <GridViewColumn.CellTemplate><DataTemplate>
       <Grid Margin="3,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Path Width="11" Height="13" Stretch="Uniform" VerticalAlignment="Center" Stroke="#A9BDB9" StrokeThickness="1.2" Data="M 3,1 L 9,1 L 8,6 L 10,8 L 2,8 L 4,6 Z M 6,8 L 6,13">
         <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
        </Path>
        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </DataTemplate></GridViewColumn.CellTemplate>
     </GridViewColumn>
     <GridViewColumn Width="215"><GridViewColumn.Header><GridViewColumnHeader x:Name="MapHeader" Content="{DynamicResource Map}" Tag="Map"/></GridViewColumn.Header>
      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MapDisplay}" Foreground="{StaticResource Muted}" Margin="3,0" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
     </GridViewColumn>
     <GridViewColumn Width="85"><GridViewColumn.Header><GridViewColumnHeader x:Name="PlayersHeader" Style="{StaticResource NumberHeader}" Content="{DynamicResource Players}" Tag="Players"/></GridViewColumn.Header>
      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Players}" TextAlignment="Right" Margin="0,0,3,0"/></DataTemplate></GridViewColumn.CellTemplate>
     </GridViewColumn>
     <GridViewColumn Width="92"><GridViewColumn.Header><GridViewColumnHeader x:Name="LatencyHeader" Style="{StaticResource NumberHeader}" Content="{DynamicResource Latency}" Tag="Latency"/></GridViewColumn.Header>
      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Latency}" TextAlignment="Right" Margin="0,0,3,0"/></DataTemplate></GridViewColumn.CellTemplate>
     </GridViewColumn>
    </GridView></ListView.View>
   </ListView>
  </DockPanel>
  <Border Grid.Column="2" x:Name="DetailsPane" Width="314" Visibility="Collapsed" Background="#202128" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="15,15,15,13">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="×" Click="CloseDetailsClick" ToolTip="{DynamicResource CloseDetails}" AutomationProperties.Name="{DynamicResource CloseDetails}" Padding="0" Width="30" Height="29"/>
      <Button DockPanel.Dock="Right" Content="↻" FontSize="16" Width="30" Height="29" Padding="0" Margin="0,0,6,0"
       Click="RefreshDetailsClick" ToolTip="{DynamicResource RefreshDetails}" AutomationProperties.Name="{DynamicResource RefreshDetails}"/>
      <TextBlock Text="{DynamicResource Details}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="DetailsName" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="DetailsOriginal" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
     <DockPanel Margin="0,12,0,12"><Button DockPanel.Dock="Right" Content="{DynamicResource Copy}" Click="CopyDetailsAddress" Margin="8,0,0,0"/><TextBlock x:Name="DetailsAddress" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="9">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{DynamicResource Map}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DetailsMap" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource DetailPlayers}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DetailsCount" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Latency}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DetailsLatency" Margin="0,4,0,0"/></StackPanel>
      </Grid>
     </Border>
     <TextBlock x:Name="DetailsQueryStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" Visibility="Collapsed"/>
     <TextBlock Text="{DynamicResource OnlinePlayers}" FontWeight="SemiBold" Margin="0,16,0,7"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
     <Button x:Name="DetailsJoinButton" Content="{DynamicResource Join}" Style="{StaticResource Primary}" Click="JoinDetails"/>
    </StackPanel>
    <Grid>
     <ListView x:Name="PlayerList" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="ResizePlayerColumn"
      ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Auto"
      Loaded="InitializePlayerScroll" PreviewMouseWheel="ScrollPlayersWithWheel"
      PreviewMouseDown="StopPlayerScrollOnInput" PreviewKeyDown="StopPlayerScrollOnInput">
      <ListView.View><GridView AllowsColumnReorder="False">
       <GridViewColumn x:Name="PlayerNameColumn" Width="260">
        <GridViewColumn.CellTemplate><DataTemplate>
         <TextBlock Margin="3,0" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Name}"/><Setter Property="ToolTip" Value="{Binding Name}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Text" Value="{DynamicResource NoPlayerName}"/><Setter Property="ToolTip" Value="{DynamicResource NoPlayerName}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </DataTemplate></GridViewColumn.CellTemplate>
       </GridViewColumn>
      </GridView></ListView.View>
     </ListView>
     <TextBlock x:Name="PlayerStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="9,43,9,0" IsHitTestVisible="False"/>
    </Grid>
   </DockPanel>
  </Border>
 </Grid>
</Window>
